# Образец v8project.local.yaml: подключение информационной базы к Unica.
#
# Как включить:
#   1. Скопируйте этот файл в v8project.local.yaml (рядом с v8project.yaml).
#   2. Раскомментируйте и заполните нужные строки ниже.
#   3. Проверьте в чате Cursor: unica.view {} должен показать
#      "infobase": {"configured": true, "source": "v8project.local.yaml"},
#      а unica.run с op "extensions.list" и dryRun: true — построить план без ошибок.
#
# v8project.local.yaml описывает ЭТУ машину: путь к базе, логин, пароль,
# версию платформы. Он не должен попасть в Git (enable добавляет его в .gitignore).
# Наборы исходников (source-set) и format здесь не задаются: они только в v8project.yaml.

# --- Информационная база ------------------------------------------------------
# Unica поддерживает одну базу с именем origin.
#
# infobases:
#   origin:
#     # Файловая база (путь относительно папки проекта или абсолютный).
#     # Если базы ещё нет, Unica создаст её операцией infobase.create
#     # и загрузит в неё конфигурацию из исходников.
#     connection: 'File=build/ib'
#
#     # Серверная база: обычная строка соединения 1С вместо File=...
#     # connection: 'Srvr="srv01";Ref="dev";'
#
#     # Пользователь базы. Не нужны, если в базе нет пользователей
#     # или включена аутентификация ОС.
#     user: 'Администратор'
#     password: ''

# --- Платформа 1С ---------------------------------------------------------------
# Без этого блока используется самая новая установленная платформа.
# На 8.5.4.1683 при базе с пользователями чтение расширений (extensions.list)
# падает: ibcmd config export --file отвечает "Идентификация пользователя не
# выполнена". Если установлена 8.5.4, закрепите 8.3.27.
#
# tools:
#   platform:
#     # Семейство (8.3.27) или точная сборка (8.3.27.1859).
     version: "8.3.27"
#     # Каталог bin конкретной установки; искать платформу только в нём.
#     path: "C:\\Program Files\\1cv8\\8.3.27.1859\\bin"
#     # true: ошибка, если указанная версия не найдена, вместо выбора другой.
#     strict: true

# Не добавляйте execution_timeout и push.partialLoadThreshold: Unica 0.13
# отказывается работать с конфигурацией, где они есть.
